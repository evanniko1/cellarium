# Copy to .env and fill in. The demo agent uses the Anthropic Messages API.
ANTHROPIC_API_KEY=
# Optional: override the default model.
CELLARIUM_MODEL=claude-sonnet-4-5
# HF raw downloads are ON by default (the raw corpus is uploaded). Set to 0 to force regenerate-locally instead.
# CELLARIUM_HF_HAS_RAW=0

# The model image the corpus READERS run in. Without this (and without WCECOLI_DIR), every tool that
# reads a simulation falls back to running the worker natively, which needs `wholecell` importable on
# the host — so they fail with `ModuleNotFoundError: No module named 'wholecell'`. MEASURED 2026-08-11:
# a live Cellwright turn asked for a transcript half-life, `deg_rate_provenance` errored exactly this
# way, and the agent could only report that it could not answer. `.claude/launch.json` does not set it,
# so a server started from that config has every simOut-reading tool broken.
WCECOLI_DOCKER=wcecoli-sim:latest
# Native fallback instead: leave WCECOLI_DOCKER unset and point WCECOLI_DIR at a wcEcoli checkout.
# WCECOLI_DIR=/path/to/wcEcoli
